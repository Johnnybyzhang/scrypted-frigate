# External hardware harness only. The Scrypted plugin never reads this file.
G4_KEY_SSH_TARGET=
G4_KEY_REMOTE_PATH=/var/lib/aqara-g4-relayless/runtime/session-key-cache.hex
G4_KEY_REMOTE_SUDO=0
G4_KEY_LOCAL_PATH=private/runtime/g4-session-key.hex

# Optional read-only hardware preflight endpoints.
FRIGATE_BASE_URL=
FRIGATE_API_TOKEN=
GO2RTC_API_URL=
GO2RTC_STREAM_NAME=Aqara-G4
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
G4_MQTT_PREFIX=aqara/g4
